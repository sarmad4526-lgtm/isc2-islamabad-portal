PORT=5000
NODE_ENV=development
JWT_SECRET=isc2_islamabad_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

# Default Admin Seed Credentials
ADMIN_EMAIL=admin@isc2islamabad.org
ADMIN_PASSWORD=Admin@ISC2!2026

# Turso Cloud SQLite Database (Required for Vercel Deployment)
# URL example: libsql://isc2-islamabad-portal-yourname.turso.io
TURSO_DATABASE_URL=
# Auth token generated via CLI command: turso db tokens create <db-name>
TURSO_AUTH_TOKEN=

# SMTP Mailer Settings (Optional - fallback to simulated logger if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ISC2 Islamabad Chapter" <noreply@isc2islamabad.org>

